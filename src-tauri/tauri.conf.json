{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cube Chess 512 AI",
  "version": "0.1.0",
  "identifier": "org.terraformingplanet.cubechess512",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173/",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cube Chess 512 AI",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src 'self' ws: wss:; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "Game",
    "shortDescription": "Open-source 8×8×8 chess",
    "longDescription": "Cube Chess 512 AI presents a single three-dimensional chess board with eight levels and 512 fields.",
    "copyright": "Copyright Sebastian Laskowski and contributors"
  }
}
